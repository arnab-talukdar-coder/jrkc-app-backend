# Nginx Configuration for JRKC HR Backend (jrkcrail.com)
# Place in /etc/nginx/sites-available/jrkc-backend

# -------------------------------------------------------------
# 1. PRODUCTION ENVIRONMENT: api.jrkcrail.com -> Port 5000
# -------------------------------------------------------------
server {
    listen 80;
    server_name api.jrkcrail.com;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# -------------------------------------------------------------
# 2. TEST ENVIRONMENT: api-test.jrkcrail.com -> Port 5001
# -------------------------------------------------------------
server {
    listen 80;
    server_name api-test.jrkcrail.com;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
