# Nginx Configuration for JRKC HR Backend (jrkcrail.com)
# Place in /etc/nginx/sites-available/jrkc-backend

# -------------------------------------------------------------
# 1. PRODUCTION ENVIRONMENT: api.jrkcrail.com -> Port 5000
# -------------------------------------------------------------
server {
    listen 80;
    server_name api.jrkcrail.com;

    location / {
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Origin, X-Requested-With, Content-Type, Accept, Authorization' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;

        if ($request_method = 'OPTIONS') {
            return 204;
        }

        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# -------------------------------------------------------------
# 2. TEST ENVIRONMENT: api-test.jrkcrail.com -> Port 5000
# -------------------------------------------------------------
server {
    listen 80;
    listen 443 ssl;
    server_name api-test.jrkcrail.com;

    # SSL certificates (managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/api-test.jrkcrail.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-test.jrkcrail.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
