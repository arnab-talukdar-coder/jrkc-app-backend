{
  "name": "jrkc-app-backend",
  "version": "1.0.0",
  "description": "Node.js Express REST API backend for JRKC HR & Employee Management Application",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:test": "node -e \"process.env.NODE_ENV='test'; process.env.PORT='5001'; import('./src/server.js')\"",
    "dev": "node --watch src/server.js",
    "dev:test": "node --watch -e \"process.env.NODE_ENV='test'; process.env.PORT='5001'; import('./src/server.js')\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.16.0"
  }
}
